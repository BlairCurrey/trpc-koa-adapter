{
  "name": "trpc-koa-adapter",
  "version": "1.3.0",
  "author": "Blair Currey",
  "description": "Koa adapter for tRPC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BlairCurrey/trpc-koa-adapter"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf ./dist && tsc",
    "test": "jest",
    "prettier": "prettier --write .",
    "check:prettier": "prettier --check .",
    "lint": "eslint --fix --max-warnings=0 .",
    "check:lint": "eslint --max-warnings=0 .",
    "format": "pnpm prettier && pnpm lint",
    "check:format": "pnpm check:prettier && pnpm check:lint",
    "release": "pnpm build && pnpm test && npm publish"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "trpc",
    "koa",
    "adapter",
    "middleware",
    "typescript"
  ],
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@koa/bodyparser": "^6.1.0",
    "@trpc/server": "^11.18.0",
    "@types/jest": "^30.0.0",
    "@types/koa": "^3.0.3",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "jest": "^30.4.2",
    "koa": "^3.2.1",
    "koa-bodyparser": "^4.4.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "peerDependencies": {
    "@trpc/server": "^10.0.0-rc.4 || ^11.0.0",
    "koa": ">=2.13.0"
  }
}
